{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run AI Scam Detector (Web App)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Train & Benchmark ML Models",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train_model.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Run Test Suite",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_api.py",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
